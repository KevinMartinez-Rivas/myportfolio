---
interface Props {
  icon?: string;
  glyph?: string;
}
const { icon, glyph } = Astro.props;

// Stroke-based generic glyphs (24x24, currentColor).
const glyphs: Record<string, string> = {
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  etl: '<path d="M3 7h13m-4-4 4 4-4 4M21 17H8m4-4-4 4 4 4"/>',
  cube: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5M12 12v9"/>',
  model: '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5m-18 4 9 5 9-5"/>',
  function: '<path d="M15 4c-3 0-3 2-4 6s-1 6-4 6m-1-6h8"/>',
  database: '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  code: '<path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 5l-4 14"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  spark: '<path d="M12 3v5M12 16v5M3 12h5M16 12h5M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/>',
  plug: '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0V8Zm6 9v4"/>',
  rules: '<path d="M5 4h14v16H5zM9 9h6M9 13h6M9 17h3"/>',
  prompt: '<path d="M4 5h16v11H9l-5 4V5Zm4 4 2 2-2 2m5 0h3"/>',
  agent: '<rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 8V4M9 13h.01M15 13h.01M9 16h6M3 12v3m18-3v3"/>',
  qa: '<path d="m4 12 5 5L20 6"/><path d="M4 20h16"/>',
};
const url = icon ? `https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/${icon}.svg` : undefined;
---

{
  url ? (
    <span class="Ico Ico-brand" style={`--src:url(${url})`} aria-hidden="true" />
  ) : (
    <svg
      class="Ico Ico-glyph"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={glyphs[glyph ?? 'spark']}
    />
  )
}
